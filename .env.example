# FACTLINE Environment Configuration Example
# Copy this file to .env and configure provider keys as needed

# Gemini Configuration (Canonical single model resolution)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Phase 11 Page Relevance Filtering
FACTLINE_PAGE_FILTER_ENABLED=true
FACTLINE_PAGE_RELEVANCE_THRESHOLD=0.30

# Phase 12 Context Selection / Compression
FACTLINE_CONTEXT_SELECTOR_ENABLED=true
FACTLINE_CONTEXT_RADIUS=2

# Phase 13/20 Quota Planning & Multi-Page Batching
FACTLINE_EXTRACTION_BATCH_SIZE=5
# FACTLINE_EXTRACTION_MAX_PAGES=15
# FACTLINE_EXTRACTION_PAGE_SELECTION=1,2,3

# Backend Server Configuration
DATABASE_URL=sqlite:///./factline.db
PORT=8000
HOST=127.0.0.1
DEBUG=True
